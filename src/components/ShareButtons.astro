---
import { absoluteUrl } from '../lib/paths';

interface Props {
  title: string;
  path: string;
}
const { title, path } = Astro.props;
const url = absoluteUrl(path);
const xHref = `https://x.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`;
const lineHref = `https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(url)}`;
---

<div class="share">
  <p class="share-label">シェア</p>
  <a href={xHref} target="_blank" rel="noopener noreferrer">Xでシェア</a>
  <a href={lineHref} target="_blank" rel="noopener noreferrer">LINEで送る</a>
</div>
