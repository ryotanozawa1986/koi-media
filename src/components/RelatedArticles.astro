---
import type { Article } from '../lib/articles';
import ArticleCard from './ArticleCard.astro';

interface Props {
  articles: Article[];
}
const { articles } = Astro.props;
---

{
  articles.length > 0 && (
    <section class="related">
      <h2>あわせて読みたい</h2>
      <div class="card-grid">
        {articles.map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>
    </section>
  )
}
